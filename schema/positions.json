{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "Position name. For example, Peterburg"
      },
      "callsign": {
        "type": "string",
        "description": "Position callsign. For example, Peterburg Control. Defaults to division callsign definitions"
      },
      "label": {
        "type": "string",
        "description": "Optional position label"
      },
      "labelCoordinate": {
        "type": "array",
        "description": "Optional position label coordinate",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number"
        }
      },
      "suffixes": {
        "description": "Callsign types (suffixes). For example, CTR, DEP, ARR",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "prefixes": {
        "description": "Callsign prefix, or prefixes",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "frequency": {
        "type": "number",
        "description": "Position primary frequency. When unspecified, any frequency will be valid for this position"
      },
      "parent": {
        "type": "string",
        "description": "A larger parent position that fully includes this position"
      }
    },
    "required": [
      "suffixes",
      "prefixes"
    ],
    "anyOf": [
      {
        "required": [
          "name"
        ]
      },
      {
        "required": [
          "callsign"
        ]
      }
    ]
  }
}
