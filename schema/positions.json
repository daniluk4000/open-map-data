{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" }
  },
  "additionalProperties": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Position name. For example, Peterburg"
        },
        "callsign": {
          "type": "string",
          "description": "Position callsign. For example, Peterburg Control. Defaults to division callsign definitions"
        },
        "label": {
          "type": "string",
          "description": "Optional label, displayed on map. Defaults to position ID"
        },
        "labelCoordinate": {
          "type": "array",
          "description": "Optional label coordinate. Defaults to all (or each) sectors center. When specified, only one label will be displayed for this sector",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "type": {
          "type": "string",
          "description": "Position type (suffix). For example, CTR"
        },
        "prefix": {
          "description": "Position prefix, or prefixes",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "frequency": {
          "type": "number",
          "description": "Position primary frequency. When unspecified, any frequency will be valid for this position"
        }
      },
      "required": [
        "type",
        "prefix"
      ],
      "anyOf": [
        {
          "required": ["name"]
        },
        {
          "required": ["callsign"]
        }
      ]
    }
  }
