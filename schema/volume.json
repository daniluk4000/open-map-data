{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "coordinate": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ]
    },
    "linearRing": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/coordinate"
      }
    },
    "verticalLimit": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 999,
          "description": "Flight Level. Numeric values are interpreted as FL by default."
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 0
            },
            "unit": {
              "type": "string",
              "enum": [
                "FL",
                "ft"
              ]
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "unit": {
                    "const": "FL"
                  }
                },
                "required": [
                  "unit"
                ]
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "integer",
                    "maximum": 999
                  }
                }
              }
            }
          ]
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "Feature"
      ]
    },
    "id": {
      "description": "Identifier for the volume. Must be unique for current FIR",
      "examples": [
        "EDYYHL2_315_355"
      ],
      "type": "string"
    },
    "properties": {
      "type": "object",
      "description": "Vertical limits can be specified either as a number, interpreted as Flight Level (FL) by default, or as an object with explicit `value` and `unit`. With `floor` set to 000 FL and `ceiling` set to 999 FL, enables this volume for combined display and VATSpy compatibility.",
      "properties": {
        "floor": {
          "$ref": "#/$defs/verticalLimit",
          "description": "Lower vertical border (inclusive). A numeric value is interpreted as FL. Set to 000 FL to have no lower level."
        },
        "ceiling": {
          "$ref": "#/$defs/verticalLimit",
          "description": "Upper vertical border (exclusive). A numeric value is interpreted as FL. Set to 999 FL to have no upper level."
        },
        "geometryFromVolume": {
          "type": "string",
          "description": "Will take geometry from a specific volume. In that case, geometry should be null. Useful for class g airspace when volumes have different owners depending on altitude"
        }
      },
      "required": [
        "floor",
        "ceiling"
      ]
    },
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "MultiPolygon"
            },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/linearRing"
                }
              }
            }
          },
          "required": [
            "type",
            "coordinates"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "Polygon"
            },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/linearRing"
              }
            }
          },
          "required": [
            "type",
            "coordinates"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "type",
    "properties",
    "id",
    "geometry"
  ],
  "allOf": [
    {
      "if": {
          "properties": {
            "properties": {
              "type": "object",
              "required": ["geometryFromVolume"]
            }
        },
        "required": ["properties"]
      },
      "then": {
        "properties": {
          "geometry": {"type": "null"}
        }
      }
    }
  ]
}
